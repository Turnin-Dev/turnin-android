root = true

[*]
charset = utf-8
indent_size = 4
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
ktlint_code_style = ktlint_official
ij_kotlin_imports_layout = *
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true
ktlint_function_naming_ignore_when_annotated_with = Composable, Test
ktlint_standard_class-signature = disabled
ktlint_standard_chain-wrapping = enabled
# 어노테이션 관련 규칙 비활성화
ktlint_standard_annotation = disabled
ktlint_standard_spacing-between-declarations-with-annotations = disabled
# 클래스 시그니처
ktlint_class_signature_rule_force_multiline_when_parameter_count_greater_or_equal_than = 2
# 함수 표현식, 함수 시그니처 비활성화
ktlint_standard_multiline-expression-wrapping = disabled
ktlint_standard_function-signature = disabled
# 함수 정의 시 반환 값 Line을 새로운 Line에서 시작 (off)
ktlint_standard_block-comment-initial-star-alignment = disabled
# 메서드 체이닝 체킹 해제
# 메서드 체이닝 기본 자동 정렬이 무조건 다음 줄에서 작성해야 하는데 해당 옵션이 활성화 되어있으면 린트 경고가 발생하기 때문
ktlint_standard_chain-method-continuation = disabled
# 자동 와일드카드 임포트 방지
ij_kotlin_name_count_to_use_star_import = 100
ij_kotlin_name_count_to_use_star_import_for_members = 100

[**/generated/**]
ktlint = disabled

[build-logic/**]
ktlint = disabled


